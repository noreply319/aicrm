# 로컬 개발용: 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 git에 올라가지 않습니다.

# 로컬 PostgreSQL 접속 정보
DATABASE_URL=postgresql://crm_app:<password>@localhost:5432/ai_crm

# Vercel 배포 시에는 이 파일을 쓰지 않습니다.
# Vercel ↔ Supabase 연동이 POSTGRES_URL 을 자동으로 설정하고, 앱은 그 값으로 Supabase에 접속합니다.

# AI Assistant (OpenAI) — https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=
# 선택: 모델 변경 (기본 gpt-6-luna)
# OPENAI_MODEL=gpt-6-luna
# 선택: reasoning 강도 (기본 none = 가장 빠름). reasoning 미지원 모델이면 off
# OPENAI_REASONING_EFFORT=none
# 선택: 미팅 녹음 전사 모델 (기본 gpt-4o-transcribe — 2027년 초 지원 종료 예정, 그 전에 gpt-transcribe로 변경)
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# 선택: 녹음 중 실시간 자막 모델 (기본 gpt-4o-transcribe. 단어 단위로 더 빠른 자막은 gpt-live-transcribe)
# OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-transcribe

# 구글 로그인 + 캘린더 연동 — Google Cloud Console → API 및 서비스 → 사용자 인증 정보 (OAuth 클라이언트, 웹)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback , https://<배포 도메인>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 로그인 허용 이메일 (쉼표 구분). 구글 OAuth 동의 화면의 테스트 사용자에도 등록해야 함
ALLOWED_EMAILS=
# 구글 리프레시 토큰 암호화 키: openssl rand -base64 32 (로컬·배포 다른 값 사용)
TOKEN_ENCRYPTION_KEY=
# 선택: 앱 주소. 없으면 로컬은 요청 주소, Vercel 운영은 VERCEL_PROJECT_PRODUCTION_URL 사용
# APP_URL=http://localhost:3000
