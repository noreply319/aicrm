# 로컬 개발용: 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 git에 올라가지 않습니다.

# 로컬 PostgreSQL 접속 정보
DATABASE_URL=postgresql://crm_app:<password>@localhost:5432/ai_crm

# Vercel 배포 시에는 이 파일을 쓰지 않습니다.
# Vercel ↔ Supabase 연동이 POSTGRES_URL 을 자동으로 설정하고, 앱은 그 값으로 Supabase에 접속합니다.

# AI Assistant (OpenAI) — https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=
# 선택: 모델 변경 (기본 gpt-6-luna)
# OPENAI_MODEL=gpt-6-luna
# 선택: reasoning 강도 (기본 none = 가장 빠름). reasoning 미지원 모델이면 off
# OPENAI_REASONING_EFFORT=none
# 선택: 미팅 녹음 전사 모델 (기본 gpt-4o-transcribe-diarize: 화자 구분. 2027-02-26 지원 종료 예정)
#   이름에 "diarize"가 들어간 모델이면 화자 구분, 아니면(gpt-transcribe 등) 화자 구분 없이 전사
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
